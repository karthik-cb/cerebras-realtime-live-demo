{
    "$schema": "https://schema.railpack.com",
    "steps": {
      "install": {
        "commands": ["bash -lc 'set -e; cd /app/server && python -m pip install --no-cache-dir -r requirements.txt'"]
      },
      "build": {
        "commands": []
      }
    },
    "deploy": {
      "startCommand": "uvicorn webapp.main:app --host 0.0.0.0 --port $PORT"
    }
  }  