{
    "$schema": "https://schema.railpack.com",
    "steps": {
      "install": { "commands": [
        "bash -lc 'rm -rf ./node_modules/.cache 2>/dev/null || true && npm ci --no-audit --no-fund'"
      ]},
      "build":   { "commands": ["npm run build"] }
    },
    "deploy": { "startCommand": "npx serve -s dist -l $PORT" }
  }
  