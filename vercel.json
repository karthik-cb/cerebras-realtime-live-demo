{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ],
  "env": {
    "VITE_SERVER_URL": "@vite_server_url"
  },
  "functions": {
    "client/dist/**/*.js": {
      "maxDuration": 30
    }
  }
}
